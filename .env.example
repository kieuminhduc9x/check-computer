# =============================================================================
# PC Monitor Pro - File cau hinh mau
# Copy file nay thanh ".env" (bo phan ".example") roi dien thong tin that.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows CMD)
#
# MOI MAY TINH NEN DUNG 1 FILE .env RIENG, va TOT NHAT LA MOI MAY DUNG 1 BOT
# TELEGRAM RIENG (tao nhieu bot bang @BotFather, vi du: PC_Nha_bot, PC_Cty_bot).
# Ban van co the dung chung 1 CHAT_ID (chinh la Telegram cua ban) cho tat ca
# cac bot, vi do la tai khoan Telegram nhan tin, khong phai may tinh.
# =============================================================================

# --- Bat buoc ---

# Token bot Telegram, lay tu @BotFather (lenh /newbot)
BOT_TOKEN=DAN_BOT_TOKEN_TU_BOTFATHER

# Chat ID cua ban (hoac group). Xem huong dan lay chat_id trong README.md.
# Co the dien nhieu chat_id, cach nhau boi dau phay, neu muon nhieu nguoi/thiet
# bi cung nhan duoc thong bao va cung duoc phep gui lenh dieu khien.
ALLOWED_CHAT_IDS=DAN_CHAT_ID_CUA_BAN

# --- Tuy chinh ---

# Ten hien thi cho may nay, de phan biet khi theo doi nhieu may
COMPUTER_NAME=May-Tinh-Cua-Toi

# Bao nhieu phut gui 1 lan tin "may van dang bat" (heartbeat)
HEARTBEAT_MINUTES=60

# Neu CPU hoac RAM vuot qua % nay lien tuc, tu dong canh bao qua Telegram
# (0 = tat tinh nang canh bao)
ALERT_CPU_PERCENT=90
ALERT_RAM_PERCENT=90
# So lan kiem tra lien tiep vuot nguong truoc khi canh bao (tranh bao nham
# khi CPU chi tang dot ngot trong vai giay)
ALERT_CONSECUTIVE_CHECKS=3
# Kiem tra canh bao moi bao nhieu giay (chi ap dung khi dang chay "listen")
ALERT_CHECK_INTERVAL_SECONDS=60

# --- Bat / tat tung tinh nang dieu khien tu xa (mac dinh: bat het) ---
# Neu may nay la may quan trong / dung chung, ban co the tat bot cac lenh
# nguy hiem de tranh thao tac nham.

ENABLE_SCREENSHOT=true
ENABLE_LOCK=true
ENABLE_SHUTDOWN_RESTART=true
ENABLE_NOTE=true
# Dang ky / go service tu khoi dong qua Telegram (/autostart)
ENABLE_AUTOSTART=true
ENABLE_CLOSE_APPS=true
ENABLE_OPEN_APPS=true
ENABLE_VPN=true
# Tu git pull --ff-only khi listen dang chay (0 phut = chi dung /update)
ENABLE_AUTO_UPDATE=true
AUTO_UPDATE_MINUTES=60
# ovpn hoac wg. De trong PRITUNL_CLIENT neu CLI khong nam cho mac dinh
# PRITUNL_MODE=ovpn
# PRITUNL_CLIENT=C:\Program Files (x86)\Pritunl\pritunl-client.exe
# PIN/OTP neu Pritunl hoi khi connect
# PRITUNL_PASSWORD=
# 1 = split tunnel (khuyen nghi): VPN khong nuot Telegram/internet thuong
# 0 = full tunnel: de mat /screenshot vi api.telegram.org di qua VPN
# PRITUNL_DISABLE_GATEWAY=1

# File luu ghi chu khi dung lenh /note (se duoc tao trong thu muc project)
NOTE_FILE=notes.txt
# Thu muc nhan file gui tu Telegram
INBOX_DIR=inbox
FILE_MAX_MB=45
# Bao khi listen song lai sau khoang im (phut)
OFFLINE_ALERT_MINUTES=5
# Danh thuc may khac trong LAN. May nay phai dang bat.
# WOL_TARGETS=may-phong=AA:BB:CC:DD:EE:FF
# WOL_BROADCAST=255.255.255.255
# Lenh mo remote desktop. De trong de tu tim RustDesk / AnyDesk / mstsc
# REMOTE_COMMAND=
ENABLE_FILES=true
ENABLE_CLIPBOARD=true
ENABLE_VOLUME=true
ENABLE_REMOTE=true
ENABLE_WOL=true
